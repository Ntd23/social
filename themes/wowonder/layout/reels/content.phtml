<script>
    function Wo_OpenReelDeleteBox(post_id,type = 'hide') {
        if (type == 'show') {
            var delete_box = $('#delete-reel-modal');
            delete_box.find('.btn-mat').attr('onclick', "Wo_OpenReelDeleteBox('"+post_id+"')");
            delete_box.modal('show');
          return false;
        }
        Wo_DeletePost(post_id);
    }
    var Wo_ReelsRequestingNext = false;
    var Wo_ReelsKeepDistance = 3;

	$(document).ready(function() {
		window.history.pushState({}, "", "<?php echo $wo['page_url']; ?>");
        var firstReel = $('.reels_list:not(.hidden)').first();
        if (!firstReel.length) {
            firstReel = $('.reels_list').first().removeClass('hidden');
        }
        Wo_ReelsActivate(firstReel);
        Wo_ReelsForceCurrentPlay();
        Wo_ReelsLoadNextIfNeeded();
	});

    function Wo_ReelsVideo(reel) {
        return $(reel).find('video').get(0) || null;
    }

    function Wo_ReelsPrepareVideo(video, preload) {
        if (!video) {
            return;
        }
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.preload = preload;
    }

    function Wo_ReelsPlayVideo(video) {
        if (!video) {
            return;
        }
        Wo_ReelsPrepareVideo(video, 'auto');
        video.autoplay = true;
        var playPromise = video.play();
        if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(function() {});
        }
    }

    function Wo_ReelsPauseVideo(video, preload) {
        if (!video) {
            return;
        }
        try {
            video.pause();
        } catch (e) {}
        Wo_ReelsPrepareVideo(video, preload);
    }

    function Wo_ReelsTrimDom(activeElement) {
        var activeIndex = $('.reels_list').index(activeElement);
        $('.reels_list').each(function(index, reel) {
            if (Math.abs(index - activeIndex) > Wo_ReelsKeepDistance) {
                Wo_ReelsPauseVideo(Wo_ReelsVideo(reel), 'metadata');
                $(reel).remove();
            }
        });
    }

    function Wo_ReelsActivate(nextElement) {
        if (!nextElement || !nextElement.length) {
            return;
        }

        var activeIndex = $('.reels_list').index(nextElement);
        $('.reels_list').each(function(index, reel) {
            var video = Wo_ReelsVideo(reel);
            if ($(reel).is(nextElement)) {
                Wo_ReelsPlayVideo(video);
            } else {
                Wo_ReelsPauseVideo(video, 'metadata');
            }
        });

        Wo_ReelsTrimDom(nextElement);
    }

    function Wo_ReelsForceCurrentPlay() {
        setTimeout(function() {
            var video = $('.reels_list:not(.hidden)').first().find('video').get(0) || $('video').get(0);
            Wo_ReelsPlayVideo(video);
        }, 100);
    }

    function Wo_ReelsBufferedNextCount() {
        var currentIndex = $('.reels_list:not(.hidden)').first().index();
        return $('.reels_list').filter(function(index) {
            return index > currentIndex;
        }).length;
    }

    function Wo_ReelsLoadNextIfNeeded() {
        if (Wo_ReelsRequestingNext || Wo_ReelsBufferedNextCount() > 1) {
            return;
        }
        Wo_ReelsRequestingNext = true;
	    $.get(Wo_Ajax_Requests_File(), {f:'get_next_reel_video','reels_user': "<?php echo($wo['reelOwnerName']) ?>"}, function(data) {
		    if (data.status == 200 && data.html) {
		    	$(".hidden_reels").append(data.html);
                $('.reels_list.hidden video').each(function() {
                    Wo_ReelsPauseVideo(this, 'metadata');
                });
		    }
	    }).always(function() {
            Wo_ReelsRequestingNext = false;
        });
    }

    function Wo_NextReelVideo() {
        var currentElement = $('.reels_list:not(.hidden)').first();
        var nextElement = currentElement.nextAll('.reels_list').first();
    
        if (nextElement.length) {
            currentElement.addClass('hidden');
            nextElement.removeClass('hidden');
            $('.loading_reel').html('');
            window.history.pushState({}, "", nextElement.attr('data-reel-url'));
            Wo_ReelsActivate(nextElement);
            Wo_ReelsForceCurrentPlay();
            Wo_ReelsLoadNextIfNeeded();
        } else {
            $('.loading_reel').html('');
            Wo_ReelsLoadNextIfNeeded();
        }
    }

    function Wo_PreviousReelVideo() {
        var currentElement = $('.reels_list:not(.hidden)').first();
        var previousElement = currentElement.prevAll('.reels_list').first();
    
        if (previousElement.length) {
            currentElement.addClass('hidden');
        	previousElement.removeClass('hidden');
            $('.loading_reel').html('');
            window.history.pushState({}, "", previousElement.attr('data-reel-url'));
            Wo_ReelsActivate(previousElement);
            Wo_ReelsForceCurrentPlay();
        } else {
        	$('.loading_reel').html('');
        }
    }
    
    $(document).off('swipeup.woReels', '.story-img').on('swipeup.woReels', '.story-img', function(event) {
    	Wo_NextReelVideo();
    });
    
    $(document).off('swipedown.woReels', '.story-img').on('swipedown.woReels', '.story-img', function(event) {
    	Wo_PreviousReelVideo();
    });
    
