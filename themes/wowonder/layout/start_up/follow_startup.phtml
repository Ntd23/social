<script type="text/javascript">
var wo_follow_submitting = false;

function updateFollowButtonText() {
	var selectedCount = $('.startup-user-card.selected').length;
	var button = $('.con-button');
	var template = "<?php echo $wo['lang']['follow_num']; ?>";
	var newText = template.replace('{number}', selectedCount);
	var svgHtml = ' <svg viewBox="0 0 24 24"><path fill="currentColor" d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" /></svg>';
	button.html(newText + svgHtml);
}

function toggleStartupFollow(element) {
	$(element).toggleClass('selected');
	updateFollowButtonText();
}

function toggleSelectAllStartup(select) {
	if (select) {
		$('.startup-user-card').addClass('selected');
	} else {
		$('.startup-user-card').removeClass('selected');
	}
	updateFollowButtonText();
}

function Wo_SubmitFollow() {
	if (wo_follow_submitting) {
		return;
	}
	
	var selectedUsers = [];
	$('.startup-user-card.selected').each(function() {
		selectedUsers.push($(this).attr('data-user-id'));
	});
	
	var users = selectedUsers.join(',');
	
	wo_follow_submitting = true;
	var button = $('.con-button');
	var originalHtml = button.data('original-html') || button.html();
	button.data('original-html', originalHtml);
	button.attr('disabled', true);
	button.text("<?php echo $wo['lang']['please_wait'];?>");
	
	$.ajax({
		url: Wo_Ajax_Requests_File() + '?f=follow_users',
		type: 'POST',
		dataType: 'json',
		data: {user: users},
		success: function (data) {
			if (data && (data.status == 200 || data.location)) {
				window.location.href = data.location || '<?php echo $wo['config']['site_url']; ?>';
				return;
			}

			wo_follow_submitting = false;
			button.attr('disabled', false);
			button.html(originalHtml);
		},
		error: function () {
			wo_follow_submitting = false;
			button.attr('disabled', false);
			button.html(originalHtml);
		}
	});
}
</script>
