<script>
$(document).ready(function() {
    // Select address logic
    var newAddressId = sessionStorage.getItem('new_added_address_id');
    if (newAddressId) {
        var radioBtn = $('#choose_adrs_' + newAddressId);
        if (radioBtn.length > 0) {
            radioBtn.prop('checked', true).trigger('change');
            sessionStorage.removeItem('new_added_address_id');
        }
    } else {
        if ($('.payment_address').length > 0 && $('.payment_address:checked').length === 0) {
            $('.payment_address').first().prop('checked', true).trigger('change');
        }
    }

    var options = {
      url: Wo_Ajax_Requests_File() + '?f=address&s=add&hash=' + $('.main_session').val(),
        beforeSubmit:  function () {
          $('.modal_add_address_modal_alert').empty();

          var name = $.trim($('.address_form input[name="name"]').val());
          var phone = $.trim($('.address_form input[name="phone"]').val());
          var country = $.trim($('#checkout_country').val());
          var city = $.trim($('#checkout_city').val());
          var address = $.trim($('#checkout_address').val());

          if (!name) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập họ tên người nhận.</div>');
              return false;
          }
          if (!phone) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập số điện thoại.</div>');
              return false;
          }
          if (!country) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập quốc gia.</div>');
              return false;
          }
          if (!city) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập tỉnh / thành phố.</div>');
              return false;
          }
          if (!address) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập địa chỉ cụ thể.</div>');
              return false;
          }

          $(".address_form").find('.btn-mat').attr('disabled', 'true');
          $(".address_form").find('.btn-mat').text("<?php echo($wo['lang']['please_wait']) ?>");
        },
        success: function (data) {
          $(".address_form").find('.btn-mat').text("<?php echo $wo['lang']['add'] ?>");
          $(".address_form").find('.btn-mat').removeAttr('disabled');
          if (data.status == 200) {
            $('.modal_add_address_modal_alert').html('<div class="alert alert-success bg-success"><i class="fa fa-check"></i> '+
              data.message
              +'</div>');
              if (data.address_id) {
                  sessionStorage.setItem('new_added_address_id', data.address_id);
              }
              setTimeout(function () {
                $('.modal_add_address_modal_alert').empty();
                $('#checkout_add_address_modal').modal('hide');
                $('body').removeClass('modal-open');
                $('.modal-backdrop').remove();
                $('#load_checkout').click();
              }, 1500);
          } else {
            $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger"> '+
            data.message
            +'</div>');
          }
        }
    };
    $('.address_form').ajaxForm(options);
});

function Wo_DeleteCheckoutAddress(id) {
	if (!id) return false;
	if (!confirm("Bạn có chắc chắn muốn xóa địa chỉ này?")) {
		return false;
	}
	$.post(Wo_Ajax_Requests_File() + '?f=address&s=delete&hash=' + $('.main_session').val(), {id: id}, function(data) {
		if (data.status == 200) {
			$('#address_item_' + id).slideUp(300, function() {
				$(this).remove();
				if ($('.cart_chos_addrs li').length === 0) {
					location.reload();
				}
			});
		} else {
			alert(data.message || "Đã xảy ra lỗi khi xóa địa chỉ.");
		}
	}, 'json');
}
</script>
