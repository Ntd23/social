<script>
$(document).ready(function() {
    var isCheckoutAddressSelected = false;

    <?php if ($wo['config']['google_map'] == 1) { ?>
    if (typeof google === 'object' && typeof google.maps === 'object' && typeof google.maps.places === 'object') {
        var checkoutAddressInput = document.getElementById('checkout_address');
        if (checkoutAddressInput) {
            var checkoutAutocomplete = new google.maps.places.Autocomplete(checkoutAddressInput, {
                types: ['geocode']
            });

            checkoutAutocomplete.addListener('place_changed', function() {
                var place = checkoutAutocomplete.getPlace();
                if (!place.geometry) {
                    isCheckoutAddressSelected = false;
                    return;
                }

                isCheckoutAddressSelected = true;

                var city = '';
                var country = '';

                if (place.address_components) {
                    for (var i = 0; i < place.address_components.length; i++) {
                        var component = place.address_components[i];
                        var addressType = component.types[0];

                        if (addressType === 'locality') {
                            if (!city) city = component.long_name;
                        } else if (addressType === 'administrative_area_level_1') {
                            city = component.long_name;
                        } else if (addressType === 'country') {
                            country = component.long_name;
                        }
                    }
                }

                country = country || 'Việt Nam';
                $('#checkout_country').val(country);
                $('#checkout_city').val(city);

                var cleanAddress = place.formatted_address || place.name || '';
                if (cleanAddress) {
                    var escapeReg = function(string) {
                        return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                    };
                    
                    if (country) {
                        cleanAddress = cleanAddress.replace(new RegExp(',\\s*' + escapeReg(country) + '$', 'i'), '');
                    }
                    cleanAddress = cleanAddress.replace(/,\s*(Việt Nam|Vietnam)$/i, '');
                    
                    if (city) {
                        cleanAddress = cleanAddress.replace(new RegExp(',\\s*' + escapeReg(city) + '$', 'i'), '');
                    }
                }

                $('#checkout_address').val(cleanAddress);

                // Show card preview and hide input fields
                $('#checkout_preview_text').html(cleanAddress + (city ? ', ' + city : '') + (country ? ', ' + country : ''));
                $('#checkout_address_fields_wrapper').slideUp();
                $('#checkout_address_card_preview').slideDown();
            });

            $('#checkout_change_address_btn').on('click', function() {
                $('#checkout_address').val('');
                $('#checkout_city').val('');
                $('#checkout_country').val('');
                isCheckoutAddressSelected = false;
                $('#checkout_address_card_preview').slideUp();
                $('#checkout_address_fields_wrapper').slideDown();
                setTimeout(function() {
                    $('#checkout_address').focus();
                }, 400);
            });

            $(checkoutAddressInput).on('input', function() {
                isCheckoutAddressSelected = false;
            });
        }
    }
    <?php } ?>

    var options = {
      url: Wo_Ajax_Requests_File() + '?f=address&s=add&hash=' + $('.main_session').val(),
        beforeSubmit:  function () {
          $('.modal_add_address_modal_alert').empty();

          <?php if ($wo['config']['google_map'] == 1) { ?>
          if (!isCheckoutAddressSelected) {
              $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger">Vui lòng nhập và chọn địa chỉ từ gợi ý của Google</div>');
              return false;
          }
          <?php } ?>

          $(".address_form").find('.btn-mat').attr('disabled', 'true');
          $(".address_form").find('.btn-mat').text("<?php echo($wo['lang']['please_wait']) ?>");
        },
        success: function (data) {
          $(".address_form").find('.btn-mat').text("<?php echo $wo['lang']['add'] ?>");
          $(".address_form").find('.btn-mat').removeAttr('disabled');
          if (data.status == 200) {
            $('.modal_add_address_modal_alert').html('<div class="alert alert-success bg-success"><i class="fa fa-check"></i> '+
              data.message
              +'</div>');
              setTimeout(function () {
                $('.modal_add_address_modal_alert').empty();
                location.reload();
              },2000);
          } else {
            $('.modal_add_address_modal_alert').html('<div class="alert alert-danger bg-danger"> '+
            data.message
            +'</div>');
          }
        }
    };
    $('.address_form').ajaxForm(options);
});
</script>
