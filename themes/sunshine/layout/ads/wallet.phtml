<script>
	<?php if ($wo['config']['payfast_payment'] == 1) { ?>
		function pay_using_payfast() {
			$('#pay-go-pro').modal('hide');
			$('.btn-payfast').attr('disabled', true);
			amount = $("#amount").val();
			$.post(Wo_Ajax_Requests_File() + '?f=payfast&s=load',{amount:amount}, function (data) {
				if (data.status == 200) {
		        	$('body').append(data.html);
					document.getElementById("redirectForm").submit();
		        }
		        else{
		        	$('.pay-go-pro-alert').html("<div class='alert alert-danger'>"+data.message+"</div>");
					setTimeout(function () {
						$('.pay-go-pro-alert').html("");
					},3000);
		        }
		        $('.btn-payfast').removeAttr('disabled');
			});

		}
	<?php } ?>
	<?php if ($wo['config']['braintree_payment'] == 1) { ?>
	function braintreeCheckout(payload) {
		$('#braintree_button').attr('disabled', true).text("<?php echo $wo["lang"]["please_wait"]?>");
