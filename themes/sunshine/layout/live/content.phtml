var currentFacingMode = 'user';
async function Wo_FlipCameraSetup() {
  var activeStream = window.stream || (typeof stream !== 'undefined' ? stream : null);
  if (!activeStream) return;
  currentFacingMode = currentFacingMode === 'user' ? 'environment' : 'user';
  
  activeStream.getTracks().forEach(track => track.stop());
  
  let constraints = {
    audio: true,
    video: { facingMode: currentFacingMode }
  };
  
  try {
    const newStream = await navigator.mediaDevices.getUserMedia(constraints);
    if (window.stream) {
      window.stream = newStream;
    }
    if (typeof stream !== 'undefined') {
      stream = newStream;
    }
    let vidWin = document.getElementsByTagName('video')[0];
    if (vidWin) {
      vidWin.srcObject = newStream;
    }
    
    let micMuted = $('.js-toggle-mic-mobile').hasClass('is-muted');
    let camMuted = $('.js-toggle-cam-mobile').hasClass('is-muted');
    newStream.getAudioTracks().forEach(track => track.enabled = !micMuted);
    newStream.getVideoTracks().forEach(track => track.enabled = !camMuted);
  } catch (err) {
    console.error("Error flipping camera: ", err);
  }
}

