// Watch live_post_id to start/stop live timer on mobile
var liveTimerIntervalMobile = null;
var liveStartedAtMobile = null;
setInterval(function() {
  var postId = $('#live_post_id').val();
  if (postId && !liveStartedAtMobile) {
    liveStartedAtMobile = Date.now();
    var mobBtn = document.querySelector('.mobile-live-btn');
    if (mobBtn) {
      mobBtn.textContent = '00:00';
    }
    // Hide mobile description field if empty when live
    var descVal = $.trim($('#live_title_mobile').val() || '');
    if (!descVal) {
      $('.mobile-setup-footer .mobile-desc-field').hide();
    }
    liveTimerIntervalMobile = setInterval(function() {
      var elapsed = Math.floor((Date.now() - liveStartedAtMobile) / 1000);
      var safe = Math.max(0, elapsed);
      var hours = Math.floor(safe / 3600);
      var minutes = Math.floor((safe % 3600) / 60);
      var seconds = safe % 60;
      var durationStr = '';
      if (hours > 0) {
        durationStr = String(hours).padStart(2, '0') + ':' + String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
      } else {
        durationStr = String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0');
      }
      if (mobBtn) {
        mobBtn.textContent = durationStr;
      }
    }, 1000);
  } else if (!postId && liveStartedAtMobile) {
    clearInterval(liveTimerIntervalMobile);
    liveTimerIntervalMobile = null;
    liveStartedAtMobile = null;
    var mobBtn = document.querySelector('.mobile-live-btn');
    if (mobBtn) {
      mobBtn.textContent = 'Phát trực tiếp';
    }
    $('.mobile-setup-footer .mobile-desc-field').show();
  }
}, 1000);
</script>